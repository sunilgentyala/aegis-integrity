# MCP-server image (stdio transport), used for Glama / MCP registry checks.
# The main Dockerfile runs the REST API (`aegis serve`); this one runs the
# MCP server (`aegis_mcp.py`), which answers initialize/tools/list over stdio.
FROM python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN pip install --no-cache-dir -e ".[ml,nlp,bib,mcp]"

ENV AEGIS_INDEX_DIR=/data/index
ENV AEGIS_REPORT_DIR=/data/reports
ENV AEGIS_DEVICE=cpu

RUN groupadd --gid 1000 aegis \
    && useradd --uid 1000 --gid aegis --shell /bin/bash --create-home aegis \
    && mkdir -p /data \
    && chown -R aegis:aegis /app /data

USER aegis

ENTRYPOINT ["python", "aegis_mcp.py"]
